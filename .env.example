# ==============================================================================
# Environment Configuration Template
# Copy to .env for local compose runs. Do not commit actual secrets to git.
# ==============================================================================

# PostgreSQL superuser & server
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_PORT=5432

# Dedicated per-service PostgreSQL database passwords
CATALOG_DB_PASSWORD=catalog_dev_password
ORDERING_DB_PASSWORD=ordering_dev_password
NOTIFICATIONS_DB_PASSWORD=notifications_dev_password

# RabbitMQ
RABBITMQ_DEFAULT_USER=shop_guest
RABBITMQ_DEFAULT_PASS=shop_guest_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Mailpit (SMTP sink & dev web UI)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Aspire Standalone Dashboard (OTLP & Telemetry UI)
DASHBOARD_PORT=18888
OTEL_EXPORTER_OTLP_ENDPOINT=http://aspire-dashboard:18889

# API Gateway host port
GATEWAY_PORT=8080

# Health checks exposure (true in development and compose, default false in production)
HEALTHCHECKS_EXPOSE=true
