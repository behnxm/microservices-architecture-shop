{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": "http://localhost:3000"
  },
  "HealthChecks": {
    "Expose": true
  },
  "ReverseProxy": {
    "Routes": {
      "products-route": {
        "ClusterId": "catalog-cluster",
        "RateLimiterPolicy": "standard-policy",
        "Timeout": "00:00:10",
        "Match": {
          "Path": "/api/v1/products/{**catch-all}"
        }
      },
      "orders-route": {
        "ClusterId": "ordering-cluster",
        "RateLimiterPolicy": "orders-policy",
        "Timeout": "00:00:10",
        "Match": {
          "Path": "/api/v1/orders/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "catalog-cluster": {
        "Destinations": {
          "catalog-api": {
            "Address": "http://catalog-api"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/alive"
          },
          "Passive": {
            "Enabled": true
          }
        }
      },
      "ordering-cluster": {
        "Destinations": {
          "ordering-api": {
            "Address": "http://ordering-api"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/alive"
          },
          "Passive": {
            "Enabled": true
          }
        }
      }
    }
  }
}
